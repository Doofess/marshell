{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.marshell/run/endpoint.json)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shell.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "webview"
  ],
  "skillOverrides": {
    "underwater-photoshop": "off",
    "dataviz": "off"
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Supabase"
    },
    {
      "serverName": "claude.ai Resend"
    },
    {
      "serverName": "claude.ai Cloudflare Developer Platform"
    }
  ],
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false,
    "engineering@synced": false,
    "design@synced": false,
    "good-css@good-css": true
  },
  "extraKnownMarketplaces": {
    "good-css": {
      "source": {
        "source": "github",
        "repo": "vojtaholik/good-css"
      }
    }
  }
}
