{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.marshell/run/endpoint.json)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "enabledMcpjsonServers": [
    "webview"
  ],
  "skillOverrides": {
    "underwater-photoshop": "off",
    "dataviz": "off"
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Supabase"
    },
    {
      "serverName": "claude.ai Resend"
    },
    {
      "serverName": "claude.ai Cloudflare Developer Platform"
    }
  ],
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false,
    "engineering@synced": false,
    "design@synced": false,
    "good-css@good-css": true
  },
  "extraKnownMarketplaces": {
    "good-css": {
      "source": {
        "source": "github",
        "repo": "vojtaholik/good-css"
      }
    }
  }
}
