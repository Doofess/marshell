#!/bin/sh
# Marshell's BROWSER for a WSL distro with no opener of its own (no wslview or xdg-open): it opens an
# http(s) URL in the Windows default browser, so an agent's sign-in page can open. Anything else is refused.
case "$1" in http://*|https://*) ;; *) exit 1 ;; esac
# Windows isn't always on C:. cmd.exe (through WSL interop) names it; without interop on PATH, or with an answer that isn't a
# drive path (an unexpanded %SystemRoot%), it falls back to C:\Windows.
root="$(cmd.exe /d /c 'echo %SystemRoot%' 2>/dev/null | tr -d '\r')"
case "$root" in [A-Za-z]:\\*) ;; *) root='C:\Windows' ;; esac
exec "$(wslpath -u "$root\\System32\\rundll32.exe")" url.dll,FileProtocolHandler "$1"
