{
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "echo done" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python ./guard.py", "timeout": 10 }
        ]
      }
    ]
  },
  "statusLine": { "type": "command", "command": "python ./line.py", "padding": 1 }
}
