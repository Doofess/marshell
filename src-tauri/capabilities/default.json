{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:webview:deny-internal-toggle-devtools",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "window-state:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    },
    "allow-save-diagnostics",
    "allow-save-conversation",
    "allow-pick-file",
    "allow-pick-folder",
    "allow-core-endpoint",
    "allow-elevated-input",
    "allow-elevated-resize",
    "allow-elevated-create",
    "allow-elevated-restart",
    "allow-elevated-resume",
    "allow-elevated-reopen",
    "allow-elevated-decide",
    "allow-close-once",
    "allow-capture-screen-region",
    "allow-cancel-capture",
    "allow-read-clipboard-image",
    "allow-set-badge",
    "allow-set-tray",
    "allow-notification-link",
    "allow-set-notification-link",
    "allow-set-window-background"
  ]
}
