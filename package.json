{
  "name": "marshell",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "build:hook": "cargo build -p marshell-hook -p marshell-cli",
    "build:hook:release": "cargo build --release -p marshell-hook -p marshell-cli",
    "check:generated": "node scripts/check-generated.mjs",
    "fetch:conpty": "node scripts/fetch-conpty.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "review:build": "node scripts/build-review.mjs",
    "a11y:matrix": "node scripts/a11y-matrix.mjs",
    "scrub:fixtures": "node scripts/scrub-fixtures.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/culori": "^4.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "culori": "^4.0.2",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
